+func flowServiceIDFromRoomName(roomName livekit.RoomName) string {
+	const prefix = "flow-"
+	const uuidLength = 36
+	value := string(roomName)
+	if len(value) != len(prefix)+uuidLength+1+uuidLength || value[:len(prefix)] != prefix {
+		return ""
+	}
+	serviceID := value[len(prefix) : len(prefix)+uuidLength]
+	roomID := value[len(prefix)+uuidLength+1:]
+	if value[len(prefix)+uuidLength] != '-' || !isUUIDText(serviceID) || !isUUIDText(roomID) {
+		return ""
+	}
+	return serviceID
+}
+
+func isUUIDText(value string) bool {
+	if len(value) != 36 {
+		return false
+	}
+	for index := range value {
+		if index == 8 || index == 13 || index == 18 || index == 23 {
+			if value[index] != '-' {
+				return false
+			}
+			continue
+		}
+		character := value[index]
+		if !((character >= '0' && character <= '9') || (character >= 'a' && character <= 'f')) {
+			return false
+		}
+	}
+	return true
+}

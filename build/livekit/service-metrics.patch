+package telemetry
+
+import (
+	"testing"
+
+	"github.com/livekit/protocol/livekit"
+	"github.com/stretchr/testify/require"
+)
+
+func TestFlowServiceIDFromRoomName(t *testing.T) {
+	serviceID := "019fbdfa-4920-70e0-899d-c5bed06903a0"
+	roomID := "019fbdfc-9891-7dc3-a57b-83637604d1dd"
+	require.Equal(t, serviceID, flowServiceIDFromRoomName(livekit.RoomName("flow-"+serviceID+"-"+roomID)))
+
+	for _, roomName := range []string{
+		"flow-" + roomID,
+		"flow-" + serviceID + "-not-a-uuid",
+		"flow-019FBDFA-4920-70E0-899D-C5BED06903A0-" + roomID,
+		"customer-room",
+	} {
+		require.Empty(t, flowServiceIDFromRoomName(livekit.RoomName(roomName)))
+	}
+}

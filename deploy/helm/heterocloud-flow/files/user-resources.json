        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "query_result(max by(user_id,user_name)(heterocloud_service_info))",
        "query": {
          "query": "query_result(max by(user_id,user_name)(heterocloud_service_info))",
          "refId": "user"
        },
        "regex": "/user_id=\"(?<value>[^\"]+)\"|user_name=\"(?<text>[^\"]+)\"/g",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {}
      }
    ]
  },

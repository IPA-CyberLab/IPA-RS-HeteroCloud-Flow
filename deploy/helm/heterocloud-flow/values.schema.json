{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "runtime",
    "providerAuth",
    "principalAuth",
    "rateLimit",
    "database",
    "api",
    "matchmaker",
    "signaling",
    "livekit",
    "coturn",
    "secrets"
  ],
  "properties": {
    "runtime": {
      "type": "object",
      "required": ["hostNetwork"],
      "properties": {
        "hostNetwork": {"type": "boolean"}
      }
    },
    "providerAuth": {
      "type": "object",
      "required": ["issuer", "audience", "publicKeysSecretKey"],
      "properties": {
        "issuer": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "publicKeysSecretKey": {"type": "string", "minLength": 1}
      }
    },
    "principalAuth": {
      "type": "object",
      "required": [
        "issuer",
        "audience",
        "maxTokenTtlSeconds",
        "contextSecretKey"
      ],
      "properties": {
        "issuer": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "maxTokenTtlSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        },
        "contextSecretKey": {"type": "string", "minLength": 1}
      }
    },
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestsPerSecond", "burst", "trustedProxyCidrs"],
      "properties": {
        "requestsPerSecond": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "burst": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "trustedProxyCidrs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 64}
        }
      }
    },
    "database": {
      "type": "object",
      "required": ["externalPort", "maxConnections"],
      "properties": {
        "externalPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "maxConnections": {
          "type": "object",
          "required": ["api", "matchmaker", "signaling"],
          "properties": {
            "api": {"type": "integer", "minimum": 1, "maximum": 30},
            "matchmaker": {"type": "integer", "minimum": 1, "maximum": 30},
            "signaling": {"type": "integer", "minimum": 1, "maximum": 30}
          }
        }
      }
    },
    "api": {
      "type": "object",
      "required": ["replicaCount", "publicUrls", "publicService"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 3, "maximum": 16},
        "publicUrls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^https://"}
        },
        "publicService": {
          "type": "object",
          "required": ["enabled", "port", "annotations"],
          "properties": {
            "enabled": {"type": "boolean"},
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {"type": "object"}
          }
        }
      }
    },
    "matchmaker": {
      "type": "object",
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 3}
      }
    },
    "signaling": {
      "type": "object",
      "required": ["replicaCount", "publicUrls", "publicService"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 3},
        "publicUrls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^wss://"}
        },
        "publicService": {
          "type": "object",
          "required": ["enabled", "port", "annotations"],
          "properties": {
            "enabled": {"type": "boolean"},
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {"type": "object"}
          }
        }
      }
    },
    "livekit": {
      "type": "object",
      "required": ["replicaCount", "publicUrls", "signal", "metrics"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 3},
        "publicUrls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^wss://"}
        },
        "signal": {
          "type": "object",
          "required": ["servicePort", "publicService"],
          "properties": {
            "servicePort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "publicService": {
              "type": "object",
              "required": ["enabled", "port", "annotations"],
              "properties": {
                "enabled": {"type": "boolean"},
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "annotations": {"type": "object"}
              }
            }
          }
        },
        "metrics": {
          "type": "object",
          "required": ["port", "urls"],
          "properties": {
            "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
            "urls": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^http://"}
            }
          }
        }
      }
    },
    "coturn": {
      "type": "object",
      "required": ["replicaCount", "publicHosts", "relayAddress", "metrics"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 3},
        "publicHosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9.-]+$"
          }
        },
        "relayAddress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "mappings"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["host", "direct-public", "one-to-one-nat"]
            },
            "mappings": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["nodeName", "publicIp", "privateIp"],
                "properties": {
                  "nodeName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                  },
                  "publicIp": {"type": "string", "format": "ipv4"},
                  "privateIp": {"type": "string", "format": "ipv4"}
                }
              }
            }
          }
        },
        "relayPortMin": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "relayPortMax": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "metrics": {
          "type": "object",
          "required": ["port", "urls"],
          "properties": {
            "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
            "urls": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^http://"}
            }
          }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prometheus"],
      "properties": {
        "prometheus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "image",
            "initImage",
            "scrapeInterval",
            "evaluationInterval",
            "retentionTime",
            "retentionSize",
            "externalLabels",
            "service",
            "storage",
            "nodeSelector",
            "tolerations",
            "resources"
          ],
          "properties": {
            "enabled": {"type": "boolean"},
            "image": {"$ref": "#/$defs/containerImage"},
            "initImage": {"$ref": "#/$defs/containerImage"},
            "scrapeInterval": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
            },
            "evaluationInterval": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
            },
            "retentionTime": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(h|d|w|y)$"
            },
            "retentionSize": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(MB|GB|TB|MiB|GiB|TiB)$"
            },
            "externalLabels": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"type": "string", "minLength": 1}
            },
            "service": {
              "type": "object",
              "additionalProperties": false,
              "required": ["port"],
              "properties": {
                "port": {"type": "integer", "minimum": 1024, "maximum": 65535}
              }
            },
            "storage": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "emptyDir", "hostPath"],
              "properties": {
                "type": {"type": "string", "enum": ["emptyDir", "hostPath"]},
                "emptyDir": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["sizeLimit"],
                  "properties": {
                    "sizeLimit": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"}
                  }
                },
                "hostPath": {"type": "string"}
              }
            },
            "nodeSelector": {
              "type": "object",
              "additionalProperties": {"type": "string"}
            },
            "tolerations": {
              "type": "array",
              "items": {"type": "object"}
            },
            "resources": {"type": "object"}
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {"type": "string"},
        "create": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "containerImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    }
  }
}

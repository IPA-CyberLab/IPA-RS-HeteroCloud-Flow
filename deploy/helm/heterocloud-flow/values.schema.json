{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "runtime",
    "providerAuth",
    "principalAuth",
    "database",
    "api",
    "matchmaker",
    "signaling",
    "livekit",
    "coturn",
    "secrets"
  ],
  "properties": {
    "runtime": {
      "type": "object",
      "required": ["hostNetwork"],
      "properties": {
        "hostNetwork": {"type": "boolean"}
      }
    },
    "providerAuth": {
      "type": "object",
      "required": ["issuer", "audience", "publicKeysSecretKey"],
      "properties": {
        "issuer": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "publicKeysSecretKey": {"type": "string", "minLength": 1}
      }
    },
    "principalAuth": {
      "type": "object",
      "required": [
        "issuer",
        "audience",
        "maxTokenTtlSeconds",
        "contextSecretKey"
      ],
      "properties": {
        "issuer": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "maxTokenTtlSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        },
        "contextSecretKey": {"type": "string", "minLength": 1}
      }
    },
    "database": {
      "type": "object",
      "required": ["externalPort", "maxConnections"],
      "properties": {
        "externalPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "maxConnections": {
          "type": "object",
          "required": ["api", "matchmaker", "signaling"],
          "properties": {
            "api": {"type": "integer", "minimum": 1, "maximum": 30},
            "matchmaker": {"type": "integer", "minimum": 1, "maximum": 30},
            "signaling": {"type": "integer", "minimum": 1, "maximum": 30}
          }
        }
      }
    },
    "api": {
      "type": "object",
      "required": ["replicaCount", "publicUrls", "publicService"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 3},
        "publicUrls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^https://"}
        },
        "publicService": {
          "type": "object",
          "required": ["enabled", "port", "annotations"],
          "properties": {
            "enabled": {"type": "boolean"},
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {"type": "object"}
          }
        }
      }
    },
    "matchmaker": {
      "type": "object",
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 3}
      }
    },
    "signaling": {
      "type": "object",
      "required": ["replicaCount", "publicUrls", "publicService"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 3},
        "publicUrls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^wss://"}
        },
        "publicService": {
          "type": "object",
          "required": ["enabled", "port", "annotations"],
          "properties": {
            "enabled": {"type": "boolean"},
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {"type": "object"}
          }
        }
      }
    },
    "livekit": {
      "type": "object",
      "required": ["replicaCount", "publicUrls", "signal"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 3},
        "publicUrls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^wss://"}
        },
        "signal": {
          "type": "object",
          "required": ["servicePort", "publicService"],
          "properties": {
            "servicePort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "publicService": {
              "type": "object",
              "required": ["enabled", "port", "annotations"],
              "properties": {
                "enabled": {"type": "boolean"},
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "annotations": {"type": "object"}
              }
            }
          }
        }
      }
    },
    "coturn": {
      "type": "object",
      "required": ["replicaCount", "publicHosts"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 3},
        "publicHosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9.-]+$"
          }
        },
        "relayPortMin": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "relayPortMax": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {"type": "string"},
        "create": {"type": "boolean"}
      }
    }
  }
}

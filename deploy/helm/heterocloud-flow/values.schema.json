{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "runtime",
    "providerAuth",
    "principalAuth",
    "rateLimit",
    "database",
    "api",
    "matchmaker",
    "signaling",
    "livekit",
    "coturn",
    "secrets"
  ],
  "properties": {
    "runtime": {
      "type": "object",
      "required": ["hostNetwork"],
      "properties": {
        "hostNetwork": {"type": "boolean"}
      }
    },
    "providerAuth": {
      "type": "object",
      "required": ["issuer", "audience", "publicKeysSecretKey"],
      "properties": {
        "issuer": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "publicKeysSecretKey": {"type": "string", "minLength": 1}
      }
    },
    "principalAuth": {
      "type": "object",
      "required": [
        "issuer",
        "audience",
        "maxTokenTtlSeconds",
        "contextSecretKey"
      ],
      "properties": {
        "issuer": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "maxTokenTtlSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        },
        "contextSecretKey": {"type": "string", "minLength": 1}
      }
    },
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestsPerSecond", "burst", "trustedProxyCidrs"],
      "properties": {
        "requestsPerSecond": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "burst": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "trustedProxyCidrs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 64}
        }
      }
    },
    "database": {
      "type": "object",
      "required": ["externalPort", "nodeSelector", "maxConnections"],
      "properties": {
        "externalPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "proxy": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "addresses": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 7, "maxLength": 45}
            },
            "endpointNodeNames": {
              "type": "object",
              "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 63}
            }
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "maxConnections": {
          "type": "object",
          "required": ["api", "matchmaker", "signaling"],
          "properties": {
            "api": {"type": "integer", "minimum": 1, "maximum": 30},
            "matchmaker": {"type": "integer", "minimum": 1, "maximum": 30},
            "signaling": {"type": "integer", "minimum": 1, "maximum": 30}
          }
        }
      }
    },
    "api": {
      "type": "object",
      "required": ["replicaCount", "publicUrls", "publicService"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 3, "maximum": 16},
        "publicUrls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^https://"}
        },
        "publicService": {
          "type": "object",
          "required": [
            "enabled",
            "port",
            "annotations",
            "loadBalancerSourceRanges"
          ],
          "properties": {
            "enabled": {"type": "boolean"},
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {"type": "object"},
            "loadBalancerSourceRanges": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 3, "maxLength": 64}
            }
          }
        }
      }
    },
    "matchmaker": {
      "type": "object",
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 3}
      }
    },
    "signaling": {
      "type": "object",
      "required": ["replicaCount", "publicUrls", "publicService"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 3},
        "publicUrls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^wss://"}
        },
        "publicService": {
          "type": "object",
          "required": [
            "enabled",
            "port",
            "annotations",
            "loadBalancerSourceRanges"
          ],
          "properties": {
            "enabled": {"type": "boolean"},
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {"type": "object"},
            "loadBalancerSourceRanges": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 3, "maxLength": 64}
            }
          }
        }
      }
    },
    "livekit": {
      "type": "object",
      "required": ["replicaCount", "publicUrls", "signal", "metrics"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 3},
        "publicUrls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^wss://"}
        },
        "signal": {
          "type": "object",
          "required": ["servicePort", "publicService"],
          "properties": {
            "servicePort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "publicService": {
              "type": "object",
              "required": [
                "enabled",
                "port",
                "annotations",
                "loadBalancerSourceRanges"
              ],
              "properties": {
                "enabled": {"type": "boolean"},
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "annotations": {"type": "object"},
                "loadBalancerSourceRanges": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 64
                  }
                }
              }
            }
          }
        },
        "metrics": {
          "type": "object",
          "required": ["port", "urls"],
          "properties": {
            "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
            "urls": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^http://"}
            }
          }
        }
      }
    },
    "coturn": {
      "type": "object",
      "required": ["replicaCount", "publicHosts", "relayAddress", "performance", "metrics"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 3},
        "additionalPools": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "replicaCount",
              "servicePort",
              "relayPortMin",
              "relayPortMax",
              "metricsPort"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "replicaCount": {"type": "integer", "minimum": 1, "maximum": 16},
              "servicePort": {"type": "integer", "minimum": 1024, "maximum": 65535},
              "relayPortMin": {"type": "integer", "minimum": 1024, "maximum": 65535},
              "relayPortMax": {"type": "integer", "minimum": 1024, "maximum": 65535},
              "metricsPort": {"type": "integer", "minimum": 1024, "maximum": 65535}
            }
          }
        },
        "publicHosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9.-]+$"
          }
        },
        "relayAddress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "mappings"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["host", "direct-public", "one-to-one-nat"]
            },
            "mappings": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["nodeName", "publicIp", "privateIp"],
                "properties": {
                  "nodeName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                  },
                  "publicIp": {"type": "string", "format": "ipv4"},
                  "privateIp": {"type": "string", "format": "ipv4"}
                }
              }
            }
          }
        },
        "relayPortMin": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "relayPortMax": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "performance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tuningImage",
            "multiplexPeer",
            "socketBufferBytes",
            "tuneHostUdpBuffers",
            "hostReceiveBufferMaxBytes",
            "hostSendBufferMaxBytes",
            "hostNetdevMaxBacklog"
          ],
          "properties": {
            "tuningImage": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "tag", "pullPolicy"],
              "properties": {
                "repository": {"type": "string", "minLength": 1},
                "tag": {"type": "string", "minLength": 1},
                "pullPolicy": {
                  "type": "string",
                  "enum": ["Always", "IfNotPresent", "Never"]
                }
              }
            },
            "multiplexPeer": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "maxPeersPerAllocation", "udpGso"],
              "properties": {
                "enabled": {"type": "boolean"},
                "maxPeersPerAllocation": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "udpGso": {"type": "boolean"}
              }
            },
            "socketBufferBytes": {
              "type": "integer",
              "minimum": 262144,
              "maximum": 67108864
            },
            "tuneHostUdpBuffers": {"type": "boolean"},
            "hostReceiveBufferMaxBytes": {
              "type": "integer",
              "minimum": 262144,
              "maximum": 268435456
            },
            "hostSendBufferMaxBytes": {
              "type": "integer",
              "minimum": 262144,
              "maximum": 268435456
            },
            "hostNetdevMaxBacklog": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 1048576
            }
          }
        },
        "metrics": {
          "type": "object",
          "required": ["port", "urls"],
          "properties": {
            "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
            "urls": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^http://"}
            }
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prometheus", "grafana"],
      "properties": {
        "prometheus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "replicaCount",
            "image",
            "initImage",
            "scrapeInterval",
            "evaluationInterval",
            "retentionTime",
            "retentionSize",
            "externalLabels",
            "additionalScrapeNamespaces",
            "service",
            "vpnAccess",
            "heteronetwork",
            "storage",
            "nodeSelector",
            "tolerations",
            "podDisruptionBudget",
            "resources"
          ],
          "properties": {
            "enabled": {"type": "boolean"},
            "replicaCount": {"type": "integer", "minimum": 1, "maximum": 64},
            "image": {"$ref": "#/$defs/containerImage"},
            "initImage": {"$ref": "#/$defs/containerImage"},
            "scrapeInterval": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
            },
            "evaluationInterval": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
            },
            "retentionTime": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(h|d|w|y)$"
            },
            "retentionSize": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(MB|GB|TB|MiB|GiB|TiB)$"
            },
            "externalLabels": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"type": "string", "minLength": 1}
            },
            "additionalScrapeNamespaces": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63
              }
            },
            "service": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "port",
                "type",
                "loadBalancerClass",
                "ingressReplicas",
                "loadBalancerSourceRanges"
              ],
              "properties": {
                "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
                "type": {"type": "string", "enum": ["ClusterIP", "LoadBalancer"]},
                "loadBalancerClass": {"type": "string", "maxLength": 253},
                "ingressReplicas": {"type": "integer", "minimum": 1, "maximum": 64},
                "loadBalancerSourceRanges": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 3, "maxLength": 49}
                }
              }
            },
            "vpnAccess": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "sourceCidrs"],
              "properties": {
                "enabled": {"type": "boolean"},
                "sourceCidrs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 3, "maxLength": 49}
                }
              }
            },
            "heteronetwork": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "agentMetricsPort", "interface"],
              "properties": {
                "enabled": {"type": "boolean"},
                "agentMetricsPort": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 65535
                },
                "interface": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,15}$"
                }
              }
            },
            "storage": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "emptyDir", "hostPath"],
              "properties": {
                "type": {"type": "string", "enum": ["emptyDir", "hostPath"]},
                "emptyDir": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["sizeLimit"],
                  "properties": {
                    "sizeLimit": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"}
                  }
                },
                "hostPath": {"type": "string"}
              }
            },
            "nodeSelector": {
              "type": "object",
              "additionalProperties": {"type": "string"}
            },
            "tolerations": {
              "type": "array",
              "items": {"type": "object"}
            },
            "podDisruptionBudget": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "minAvailable"],
              "properties": {
                "enabled": {"type": "boolean"},
                "minAvailable": {"type": "integer", "minimum": 1, "maximum": 64}
              }
            },
            "resources": {"type": "object"}
          }
        },
        "grafana": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "replicaCount",
            "listenPort",
            "image",
            "prometheusUrl",
            "existingSecret",
            "secretKeys",
            "anonymousViewerEnabled",
            "service",
            "vpnAccess",
            "nodeSelector",
            "tolerations",
            "podDisruptionBudget",
            "resources"
          ],
          "properties": {
            "enabled": {"type": "boolean"},
            "replicaCount": {"type": "integer", "minimum": 1, "maximum": 64},
            "listenPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
            "image": {"$ref": "#/$defs/containerImage"},
            "prometheusUrl": {
              "type": "string",
              "pattern": "^http://"
            },
            "existingSecret": {"type": "string", "minLength": 1, "maxLength": 253},
            "secretKeys": {
              "type": "object",
              "additionalProperties": false,
              "required": ["databaseUrl", "adminUser", "adminPassword", "secretKey"],
              "properties": {
                "databaseUrl": {"type": "string", "minLength": 1, "maxLength": 253},
                "adminUser": {"type": "string", "minLength": 1, "maxLength": 253},
                "adminPassword": {"type": "string", "minLength": 1, "maxLength": 253},
                "secretKey": {"type": "string", "minLength": 1, "maxLength": 253}
              }
            },
            "anonymousViewerEnabled": {"type": "boolean"},
            "service": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "port",
                "type",
                "loadBalancerClass",
                "ingressReplicas",
                "loadBalancerSourceRanges"
              ],
              "properties": {
                "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
                "type": {"type": "string", "enum": ["ClusterIP", "LoadBalancer"]},
                "loadBalancerClass": {"type": "string", "maxLength": 253},
                "ingressReplicas": {"type": "integer", "minimum": 1, "maximum": 64},
                "loadBalancerSourceRanges": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 3, "maxLength": 49}
                }
              }
            },
            "vpnAccess": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "sourceCidrs"],
              "properties": {
                "enabled": {"type": "boolean"},
                "sourceCidrs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 3, "maxLength": 49}
                }
              }
            },
            "nodeSelector": {
              "type": "object",
              "additionalProperties": {"type": "string"}
            },
            "tolerations": {
              "type": "array",
              "items": {"type": "object"}
            },
            "podDisruptionBudget": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "minAvailable"],
              "properties": {
                "enabled": {"type": "boolean"},
                "minAvailable": {"type": "integer", "minimum": 1, "maximum": 64}
              }
            },
            "resources": {"type": "object"}
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {"type": "string"},
        "create": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "containerImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    }
  }
}

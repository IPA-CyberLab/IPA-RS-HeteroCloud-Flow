DATABASE_URL=postgres://flow:replace-me@127.0.0.1:5432/flow
DATABASE_MAX_CONNECTIONS=20
MIGRATE_ON_START=true

HETEROCLOUD_PROVIDER_ISSUER=heterocloud
HETEROCLOUD_PROVIDER_AUDIENCE=heterocloud-flow
HETEROCLOUD_PROVIDER_PUBLIC_KEYS_JSON={"provider-kid":"-----BEGIN PUBLIC KEY-----\nreplace-me\n-----END PUBLIC KEY-----\n"}

FLOW_PRINCIPAL_ISSUER=heterocloud
FLOW_PRINCIPAL_AUDIENCE=heterocloud-flow-data
FLOW_PRINCIPAL_CONTEXT_HMAC_SECRET=replace-with-at-least-32-random-bytes
FLOW_PRINCIPAL_MAX_TTL_SECONDS=300

LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_WS_URLS=wss://rtc-a.example.test,wss://rtc-b.example.test,wss://rtc-c.example.test
LIVEKIT_API_KEY=flow-dev
LIVEKIT_API_SECRET=replace-with-at-least-32-random-bytes
LIVEKIT_TOKEN_TTL_SECONDS=300

FLOW_SIGNALING_URLS=wss://flow-a.example.test,wss://flow-b.example.test,wss://flow-c.example.test
REDIS_URL=redis://127.0.0.1:6379

TURN_URLS=turn:turn-a.example.test:3478?transport=udp,turn:turn-a.example.test:3478?transport=tcp,turn:turn-b.example.test:3478?transport=udp,turn:turn-b.example.test:3478?transport=tcp,turn:turn-c.example.test:3478?transport=udp,turn:turn-c.example.test:3478?transport=tcp
TURN_SHARED_SECRET=replace-with-at-least-32-random-bytes
TURN_CREDENTIAL_TTL_SECONDS=300
